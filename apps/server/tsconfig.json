{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "target": "ES2023",

    "paths": {
      "@/*": ["./src/*"]
    },

    "rootDir": ".",
    "outDir": "./dist",

    "declaration": true,
    "removeComments": true,
    "sourceMap": true,

    "incremental": true,
    "skipLibCheck": true,

    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "forceConsistentCasingInFileNames": true
  }
}
